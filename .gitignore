# ==========================================
# AeroScan - .gitignore
# ==========================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# PyInstaller / Build Artifacts
build/
dist/
*.manifest
*.spec
!build_scripts/aeroscan.spec

# SQLite & Data files
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/*.sqlite
data/*.sqlite3
!data/.gitkeep

# Generated Reports
reports_output/*.pdf
reports_output/*.xlsx
reports_output/*.csv
reports_output/*.html
!reports_output/.gitkeep

# Frontend & Node
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/.tmp/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# IDEs & Editors
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# OS specific files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
